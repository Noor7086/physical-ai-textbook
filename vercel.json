{
  "buildCommand": "cd docusaurus && npm install && npm run build",
  "outputDirectory": "docusaurus/build",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 60,
      "excludeFiles": "{docusaurus/**,history/**,specs/**,tests/**,.specify/**,.claude/**,.git/**,node_modules/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" }
  ]
}
